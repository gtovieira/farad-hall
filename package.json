{
  "name": "farad-hall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Farad Hall: the central that manages every Farad Orquestra.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "pnpm --filter @hall/protocol generate && pnpm --filter @hall/api openapi",
    "demo": "pnpm --filter @hall/web build && tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
