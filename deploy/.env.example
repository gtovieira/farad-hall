# Farad Hall on a server: copy to deploy/.env (chmod 600) and fill in. docker compose reads it.

# The public name of Hall (DNS A/AAAA record pointing at this server) and the e-mail Let's Encrypt
# writes to about the certificate.
HALL_DOMAIN=hall.example.com.br
HALL_ACME_EMAIL=ops@example.com.br

# Image tag (the git tag or commit you deploy).
HALL_VERSION=dev

# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_ROOT_USER=hall
HALL_LOGS_BUCKET=hall-logs

# The first admin-farad, created on the first start only (when there is no user yet). Remove the
# password from this file after signing in and changing it.
HALL_ADMIN_EMAIL=
HALL_ADMIN_PASSWORD=

# Alerts: a device is offline after this many minutes without a message (changeable later in
# Hall), and who gets the e-mails (comma-separated). Without SMTP_HOST, e-mails are only logged.
HALL_ALERT_OFFLINE_MIN=5
HALL_ALERT_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Farad Hall <hall@example.com.br>

# Nightly database dump: hour (UTC; 6 = 03:00 in Brasília), days kept, host directory.
BACKUP_HOUR_UTC=6
BACKUP_KEEP_DAYS=14
HALL_BACKUP_DIR=./backups

HALL_LOG_LEVEL=info
