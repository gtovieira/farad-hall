          },
          "413": {
            "description": "Body too large (1 MiB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid message (invalid, with issues), or a protocol version Hall does not accept (unsupported-protocol, with supportedVersions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hallSignature": []
          }
        ]
      }
    },
    "/api/device/state": {
      "post": {
        "operationId": "state",
        "summary": "Health, resources, control mode and chargers",
        "tags": [
          "device"
        ],
        "parameters": [
          {
            "name": "Hall-Device",
            "in": "header",
            "required": true,
            "description": "The device id Hall gave at enrolment",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix seconds; within 300 s of Hall's clock",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Nonce",
            "in": "header",
            "required": true,
            "description": "Unique per request (16–128 of A–Z a–z 0–9 _ -); Hall refuses one seen within 600 s",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Signature",
            "in": "header",
            "required": true,
            "description": "Ed25519 signature (base64url, 64 bytes) of the HALL-ED25519-V1 canonical string",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceState"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          },
          "400": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
