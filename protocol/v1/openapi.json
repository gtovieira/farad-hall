{
  "openapi": "3.1.0",
  "info": {
    "title": "Farad Hall protocol",
    "version": "1.0.0",
    "description": "The contract between Farad Hall and the Orquestra's hall-agent: enrolment, heartbeat, state and events, each signed with the device's Ed25519 key. Messages carry protocolVersion; Hall accepts versions 1."
  },
  "tags": [
    {
      "name": "device",
      "description": "Messages from an Orquestra to Hall"
    }
  ],
  "paths": {
    "/api/device/enrol": {
      "post": {
        "operationId": "enrol",
        "summary": "Enrol: a claim code and a new public key become a device of a site",
        "description": "The device generates its Ed25519 key pair, then sends the claim code an admin created in Hall with its public key, signed with that key (Hall-Device absent; the canonical string ends in \"enrol\"). A claim code is single use and lives 24 h.",
        "tags": [
          "device"
        ],
        "parameters": [
          {
            "name": "Hall-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix seconds; within 300 s of Hall's clock",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Nonce",
            "in": "header",
            "required": true,
            "description": "Unique per request (16–128 of A–Z a–z 0–9 _ -); Hall refuses one seen within 600 s",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Signature",
            "in": "header",
            "required": true,
            "description": "Ed25519 signature (base64url, 64 bytes) of the HALL-ED25519-V1 canonical string",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrolRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Enrolled: keep the deviceId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolResponse"
                }
              }
            }
          },
          "400": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "401": {
            "description": "Signature missing or wrong (unauthorized, bad-signature), stale timestamp (stale-timestamp, with serverTime), replayed nonce (replayed-nonce), unknown device (unknown-device)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "404": {
            "description": "No such claim code (claim-code-invalid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "409": {
            "description": "This public key is already enrolled (already-enrolled)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "410": {
            "description": "The claim code expired (claim-code-expired) or was used (claim-code-used): ask for a new one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "413": {
            "description": "Body too large (1 MiB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid message (invalid, with issues), or a protocol version Hall does not accept (unsupported-protocol, with supportedVersions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts from this address (rate-limited)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hallSignature": []
          }
        ]
      }
    },
    "/api/device/events": {
      "post": {
        "operationId": "events",
        "summary": "Warning and critical events (idempotent by event id)",
        "tags": [
          "device"
        ],
        "parameters": [
          {
            "name": "Hall-Device",
            "in": "header",
            "required": true,
            "description": "The device id Hall gave at enrolment",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix seconds; within 300 s of Hall's clock",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Nonce",
            "in": "header",
            "required": true,
            "description": "Unique per request (16–128 of A–Z a–z 0–9 _ -); Hall refuses one seen within 600 s",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hall-Signature",
            "in": "header",
            "required": true,
            "description": "Ed25519 signature (base64url, 64 bytes) of the HALL-ED25519-V1 canonical string",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          },
          "400": {
            "description": "Not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "401": {
            "description": "Signature missing or wrong (unauthorized, bad-signature), stale timestamp (stale-timestamp, with serverTime), replayed nonce (replayed-nonce), unknown device (unknown-device)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "403": {
            "description": "The device is revoked (device-revoked): stop sending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "413": {
            "description": "Body too large (1 MiB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid message (invalid, with issues), or a protocol version Hall does not accept (unsupported-protocol, with supportedVersions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceError"
                }
              }
            }
          }
        },
        "security": [
          {
            "hallSignature": []
          }
        ]
      }
    },
