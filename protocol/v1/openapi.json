          "401": {
            "description": "Signature missing or wrong (unauthorized, bad-signature), stale timestamp (stale-timestamp, with serverTime), replayed nonce (replayed-nonce), unknown device (unknown-device)",
            "content": {
              "application/json": {
                "schema": {
